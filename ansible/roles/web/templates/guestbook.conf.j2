<VirtualHost *:{{ apache_puerto }}>
    ServerName {{ vhost_nombre }}
    DocumentRoot {{ vhost_docroot }}

    # Indica qué servidor web ha atendido la petición
    Header always set X-Servidor "{{ inventory_hostname }}"

    <Directory {{ vhost_docroot }}>
        AllowOverride All
        Require all granted
    </Directory>

    <DirectoryMatch "/\.git">
        Require all denied
    </DirectoryMatch>

    ErrorLog ${APACHE_LOG_DIR}/guestbook_error.log
    CustomLog ${APACHE_LOG_DIR}/guestbook_access.log combined
</VirtualHost>
