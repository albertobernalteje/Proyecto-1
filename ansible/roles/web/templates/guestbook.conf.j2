<VirtualHost *:80>
    ServerName {{ vhost_nombre }}
    DocumentRoot {{ vhost_docroot }}

    <Directory {{ vhost_docroot }}>
        AllowOverride All
        Require all granted
    </Directory>

    <DirectoryMatch "/\.git">
        Require all denied
    </DirectoryMatch>

    ErrorLog ${APACHE_LOG_DIR}/guestbook_error.log
    CustomLog ${APACHE_LOG_DIR}/guestbook_access.log combined
</VirtualHost>
